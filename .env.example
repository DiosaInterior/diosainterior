# Diosa Interior V2 — Plantilla de variables de entorno
#
# Copiar a `.env.local` (ignorado por git) y llenar con los valores reales.
# En producción / staging estas variables se configuran en Vercel.
# Referencia: /docs/BIBLIA_APP_V2_DIOSA_INTERIOR.md §11

# =====================================================================
# PÚBLICAS — expuestas al browser (prefijo NEXT_PUBLIC_)
# =====================================================================

# Supabase — URL y clave anónima del proyecto
# Dashboard: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — clave publicable (modo test arranca con pk_test_)
# Dashboard: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog — clave de proyecto (analytics + funnel)
# Dashboard: https://us.posthog.com/project/<id>/settings
NEXT_PUBLIC_POSTHOG_KEY=

# =====================================================================
# SERVIDOR — nunca expongas estas al cliente
# =====================================================================

# Supabase — service role key (bypassa RLS, solo para route handlers / jobs)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — API key para análisis colorimétrico (claude-sonnet-4-5)
# Dashboard: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Stripe — clave secreta + webhook signing secret
# Webhook secret: https://dashboard.stripe.com/test/webhooks/<id>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — email transaccional
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=

# Inngest — orquestación de jobs background
# Dashboard: https://app.inngest.com/env/production/manage/keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry — observabilidad de errores (frontend + backend)
# Vacío = SDK silenciado (no rompe build). Llenar antes del primer deploy.
# Dashboard: https://sentry.io/settings/<org>/projects/<proj>/keys/
#
# Mismo valor de DSN para client y server — el split existe porque
# Next.js requiere prefijo NEXT_PUBLIC_ para exponer la var al browser.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Sentry — slugs de organización y proyecto (usados por withSentryConfig)
SENTRY_ORG=diosainterior
SENTRY_PROJECT=javascript-nextjs

# Sentry — token de autenticación para subir source maps en build.
# Crear en: https://sentry.io/settings/auth-tokens/ con scope
# project:releases + org:read. Configurar en Vercel cuando se conecte.
# Sin este token el build pasa pero los source maps no suben.
SENTRY_AUTH_TOKEN=

# Stripe price IDs
STRIPE_PRICE_ID_BASE=

# Meta Pixel + Conversions API (G.7)
# - NEXT_PUBLIC_META_PIXEL_ID: ID del Pixel (no sensitive, va al cliente).
#   Si está vacío, el sistema queda no-op completo (no se carga el snippet
#   base, no se disparan eventos CAPI).
NEXT_PUBLIC_META_PIXEL_ID=
# - META_CAPI_ACCESS_TOKEN: Access token de Conversions API (sensitive,
#   solo server-side). Generado en Meta Events Manager → Configuración →
#   Conversions API → Generate access token.
META_CAPI_ACCESS_TOKEN=
# - META_TEST_EVENT_CODE: opcional. Cuando está, todos los eventos CAPI
#   van al Test Events Viewer de Meta y NO contaminan métricas de prod.
#   Útil para QA end-to-end. NO setear en producción.
META_TEST_EVENT_CODE=
